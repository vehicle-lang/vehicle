-- Grammar of the Vehicle External language

comment "--";
comment "{-" "-}";

-- * Tokens

-- NOTE: Token rules are tried IN ORDER, so the order matters!
position token Boolean  ({"True"} | {"False"});
position token Natural  (digit+);
position token Rational (digit+ '.' digit+);
position token Infinity {"infinity"};

position token TokAnnotation ({"@"}
  ( {"network"}
  | {"dataset"}
  | {"parameter"}
  | {"property"}
  | {"tensor"}
  | {"instance"}
  | {"builtin"}
  | {"typeclass"}
  )
);

position token TokArrow     {"->"};
position token TokForallT   {"forallT"};
position token TokIf        {"if"};
position token TokThen      {"then"};
position token TokElse      {"else"};
position token TokElemOf    {":"};
position token TokLambda    {"\\"};
position token TokLet       {"let"};

position token TokType      {"Type"};
position token TokUnit      {"Unit"};
position token TokBool      {"Bool"};
position token TokIndex     {"Index"};
position token TokNat       {"Nat"};
position token TokReal      {"Real"};
position token TokList      {"List"};
position token TokVector    {"Vector"};
position token TokTensor    {"Tensor"};
position token TokNonCastingTensor   {"NonCastingTensor"};
position token TokNonCastingReal   {"NonCastingReal"};
position token TokForall    {"forall"};
position token TokExists    {"exists"};
position token TokForeach   {"foreach"};
position token TokTranspose {"transpose"};
position token TokImpl      {"=>"};
position token TokAnd       {"and"};
position token TokOr        {"or"};
position token TokNot       {"not"};
position token TokEq        {"=="};
position token TokNe        {"!="};
position token TokLe        {"<="};
position token TokLt        {"<"};
position token TokGe        {">="};
position token TokGt        {">"};
position token TokEqPoint   {"==."};
position token TokNePoint   {"!=."};
position token TokLePoint   {"<=."};
position token TokLtPoint   {"<."};
position token TokGePoint   {">=."};
position token TokGtPoint   {">."};
position token TokMul       {"*"};
position token TokDiv       {"/"};
position token TokAdd       {"+"};
position token TokSub       {"-"};
position token TokPow       {"^"};
position token TokMin       {"min"};
position token TokMax       {"max"};
position token TokLog       {"log"};
position token TokExp       {"exp"};

position token TokAddNat    {"addNat"};
position token TokMulNat    {"mulNat"};
position token TokAddRealTensor {"addRealTensor"};
position token TokSubRealTensor {"subRealTensor"};
position token TokMulRealTensor {"mulRealTensor"};
position token TokDivRealTensor {"divRealTensor"};
position token TokQuantifyForAllIndex {"quantifyForAllIndex"};
position token TokQuantifyExistsIndex {"quantifyExistsIndex"};
position token TokQuantifyForallRealTensor {"quantifyForallRealTensor"};
position token TokQuantifyExistsRealTensor {"quantifyExistsRealTensor"};
position token TokQuantifyForallTensorLike {"quantifyForallTensorLike"};
position token TokQuantifyExistsTensorLike {"quantifyExistsTensorLike"};
position token TokCompareIndexEq {"compareIndexEq"};
position token TokCompareIndexNe {"compareIndexNe"};
position token TokCompareIndexLe {"compareIndexLe"};
position token TokCompareIndexLt {"compareIndexLt"};
position token TokCompareIndexGe {"compareIndexGe"};
position token TokCompareIndexGt {"compareIndexGt"};
position token TokCompareNatEq {"compareNatEq"};
position token TokCompareNatNe {"compareNatNe"};
position token TokCompareNatLe {"compareNatLe"};
position token TokCompareNatLt {"compareNatLt"};
position token TokCompareNatGe {"compareNatGe"};
position token TokCompareNatGt {"compareNatGt"};
position token TokCompareRatTensorPointwiseEq {"compareRatTensorPointwiseEq"};
position token TokCompareRatTensorPointwiseNe {"compareRatTensorPointwiseNe"};
position token TokCompareRatTensorPointwiseLe {"compareRatTensorPointwiseLe"};
position token TokCompareRatTensorPointwiseLt {"compareRatTensorPointwiseLt"};
position token TokCompareRatTensorPointwiseGe {"compareRatTensorPointwiseGe"};
position token TokCompareRatTensorPointwiseGt {"compareRatTensorPointwiseGt"};
position token TokCompareRatTensorReducedEq {"compareRatTensorReducedEq"};
position token TokCompareRatTensorReducedNe {"compareRatTensorReducedNe"};
position token TokCompareRatTensorReducedLe {"compareRatTensorReducedLe"};
position token TokCompareRatTensorReducedLt {"compareRatTensorReducedLt"};
position token TokCompareRatTensorReducedGe {"compareRatTensorReducedGe"};
position token TokCompareRatTensorReducedGt {"compareRatTensorReducedGt"};

position token TokNil        {"nil"};
position token TokCons       {"::"};
position token TokSeqOpen    {"["};
position token TokSeqClose   {"]"};
position token TokAt         {"!"};
position token TokMap        {"map"};
position token TokFold       {"fold"};
position token TokAppend     {"append"};

position token TokConst     {"const"};
position token TokReduceOr  {"reduceOr"};
position token TokReduceAnd {"reduceAnd"};
position token TokReduceAdd {"reduceAdd"};
position token TokReduceMul {"reduceMul"};
position token TokReduceMin {"reduceMin"};
position token TokReduceMax {"reduceMax"};

position token TokHasFold   {"HasFold"};
position token TokHasMap    {"HasMap"};
position token TokIsTensorType {"IsTensorType"};

position token TokAnnNameOpt  {"name"};
position token TokAnnInferOpt {"infer"};
position token TokAnnDefaultOpt {"default"};

-- NOTE: As order matters don't declare tokens after these ones!
position token Name         (letter (letter | digit | '_')*) ;
position token FieldAccess  ({"."} letter (letter | digit | '_')*);
position token HoleToken    ({"?"} (letter | digit | '_')*);

separator nonempty Name ",";

-- * Modalities

Irrelevant. Modality ::= "@0";

separator Modality "";

-- * Basic binders

ExplicitBinder. BasicBinder ::= "("  [Modality] Name TokElemOf Expr1 ")";
ImplicitBinder. BasicBinder ::= "{"  [Modality] Name TokElemOf Expr1 "}";
InstanceBinder. BasicBinder ::= "{{" [Modality] Name TokElemOf Expr1 "}}";

-- * Binders where the user must provide a name but can omit the type

ExplicitNameBinder. NameBinder ::= Name;
-- ExplicitNameBinderMods. NameBinder ::= "(" Modality [Modality] Name ")";  -- Causes shift-reduce conflict
ImplicitNameBinder. NameBinder ::= "{" [Modality] Name "}";
InstanceNameBinder. NameBinder ::= "{{" [Modality] Name "}}";
BasicNameBinder.    NameBinder ::= BasicBinder;

separator NameBinder "";

-- * Binders where the user must provide a type but can omit the name

ExplicitTypeBinder. TypeBinder ::= Expr14;
-- ExplicitTypeBinderMods. TypeBinder ::= "(" Modality [Modality] Expr15 ")"; -- Causes a shift/reduce conflict
ImplicitTypeBinder. TypeBinder ::= "{" [Modality] Expr1 "}";
InstanceTypeBinder. TypeBinder ::= "{{" [Modality] Expr1 "}}";
BasicTypeBinder.    TypeBinder ::= BasicBinder;

-- * Arguments6

ExplicitArg.     Arg ::= Expr17;
ExplicitArgMods. Arg ::= "(" Modality [Modality] Expr17 ")";
ImplicitArg.     Arg ::= "{" [Modality] Expr1 "}";
InstanceArg.     Arg ::= "{{" [Modality] Expr1 "}}";

-- * Individual let declarations

LDecl. LetDecl ::= NameBinder "=" Expr;

separator LetDecl ",";

-- * Records

FieldDef. RecordFieldDef ::= Name TokElemOf Expr;
separator RecordFieldDef ",";

FieldAssign. RecordFieldAssign ::= Name "=" Expr;
separator RecordFieldAssign ",";

-- * Literals

UnitLiteral.  Lit ::= "()";
BoolLiteral.  Lit ::= Boolean;
NatLiteral.   Lit ::= Natural;
RatLiteral.   Lit ::= Rational;
InfLiteral.   Lit ::= Infinity;

-- * Expressions

-- NOTE:
--
--   The syntax for expressions used by the parser is more general than that
--   permitted by our bidirectional typing, which allows us to emit an more
--   specific error message when we're missing a type annotation, rather than
--   emitting a parse error.
--
--   See https://github.com/BNFC/bnfc/issues/372 for why tokens
--   aren't used for `let` and `in`.

-- Kinds.
Type.    Expr17 ::= TokType;

-- Core structure.
Ann.       Expr   ::= Expr2 TokElemOf Expr1;
ForallT.   Expr1  ::= TokForallT [NameBinder] "." Expr1;
Let.       Expr2  ::= TokLet [LetDecl] "in" Expr2;
Lam.       Expr2  ::= TokLambda [NameBinder] TokArrow Expr2;
Fun.       Expr12 ::= TypeBinder TokArrow Expr12;
App.       Expr14 ::= Expr14 Arg;
-- This record declaration causes a shift-reduce conflict.
Record.    Expr11 ::= "{" [RecordFieldAssign] "}";
RecordAcc. Expr16 ::= Expr16 FieldAccess;
Var.       Expr17 ::= Name;
Literal.   Expr17 ::= Lit;
Hole.      Expr17 ::= HoleToken;

-- Quantification
Foreach.   Expr2 ::= TokForeach [NameBinder] "." Expr2;
Forall.    Expr2 ::= TokForall [NameBinder] "." Expr2;
Exists.    Expr2 ::= TokExists [NameBinder] "." Expr2;
ForallIn.  Expr2 ::= TokForall NameBinder "in" Expr3 "." Expr2;
ExistsIn.  Expr2 ::= TokExists NameBinder "in" Expr3 "." Expr2;

-- Numeric expressions.
Add. Expr9  ::= Expr9  TokAdd Expr10;
Sub. Expr9  ::= Expr9  TokSub Expr10;
Mul. Expr10 ::= Expr10 TokMul Expr11;
Div. Expr10 ::= Expr10 TokDiv Expr11;
Pow. Expr11 ::= Expr11 TokPow Expr12;
Neg. Expr12 ::= TokSub Expr12;

-- Boolean expressions.
If.      Expr4  ::= TokIf Expr5 TokThen Expr5 TokElse Expr5;
Impl.    Expr5  ::= Expr6 TokImpl Expr5;
And.     Expr7  ::= Expr8 TokAnd Expr7;
Or.      Expr7  ::= Expr8 TokOr  Expr7;
Not.     Expr15 ::= TokNot Expr15;
Eq.      Expr8  ::= Expr8 TokEq Expr9;
Ne.      Expr8  ::= Expr8 TokNe Expr9;
Le.      Expr8  ::= Expr8 TokLe Expr9;
Lt.      Expr8  ::= Expr8 TokLt Expr9;
Ge.      Expr8  ::= Expr8 TokGe Expr9;
Gt.      Expr8  ::= Expr8 TokGt Expr9;
EqPoint. Expr8  ::= Expr8 TokEqPoint Expr9;
NePoint. Expr8  ::= Expr8 TokNePoint Expr9;
LePoint. Expr8  ::= Expr8 TokLePoint Expr9;
LtPoint. Expr8  ::= Expr8 TokLtPoint Expr9;
GePoint. Expr8  ::= Expr8 TokGePoint Expr9;
GtPoint. Expr8  ::= Expr8 TokGtPoint Expr9;

-- Container syntax.
VecLiteral. Expr17 ::= TokSeqOpen [Expr] TokSeqClose;
Cons.       Expr4  ::= Expr5 TokCons Expr4;
At.         Expr13 ::= Expr13 TokAt Expr14;

-- Hard-coded builtins remove
Min.                          Expr17 ::= TokMin;
Max.                          Expr17 ::= TokMax;
Log.                          Expr17 ::= TokLog;
Exp.                          Expr17 ::= TokExp;
AddNat.                       Expr17 ::= TokAddNat;
MulNat.                       Expr17 ::= TokMulNat;
AddRealTensor.                Expr17 ::= TokAddRealTensor;
SubRealTensor.                Expr17 ::= TokSubRealTensor;
MulRealTensor.                Expr17 ::= TokMulRealTensor;
DivRealTensor.                Expr17 ::= TokDivRealTensor;
QuantifyForAllIndex.          Expr17 ::= TokQuantifyForAllIndex;
QuantifyExistsIndex.          Expr17 ::= TokQuantifyExistsIndex;
QuantifyForallRealTensor.     Expr17 ::= TokQuantifyForallRealTensor;
QuantifyExistsRealTensor.     Expr17 ::= TokQuantifyExistsRealTensor;
QuantifyForallTensorLike.     Expr17 ::= TokQuantifyForallTensorLike;
QuantifyExistsTensorLike.     Expr17 ::= TokQuantifyExistsTensorLike;
CompareIndexEq.               Expr17 ::= TokCompareIndexEq;
CompareIndexNe.               Expr17 ::= TokCompareIndexNe;
CompareIndexLe.               Expr17 ::= TokCompareIndexLe;
CompareIndexLt.               Expr17 ::= TokCompareIndexLt;
CompareIndexGe.               Expr17 ::= TokCompareIndexGe;
CompareIndexGt.               Expr17 ::= TokCompareIndexGt;
CompareNatEq.                 Expr17 ::= TokCompareNatEq;
CompareNatNe.                 Expr17 ::= TokCompareNatNe;
CompareNatLe.                 Expr17 ::= TokCompareNatLe;
CompareNatLt.                 Expr17 ::= TokCompareNatLt;
CompareNatGe.                 Expr17 ::= TokCompareNatGe;
CompareNatGt.                 Expr17 ::= TokCompareNatGt;
CompareRatTensorPointwiseEq.  Expr17 ::= TokCompareRatTensorPointwiseEq;
CompareRatTensorPointwiseNe.  Expr17 ::= TokCompareRatTensorPointwiseNe;
CompareRatTensorPointwiseLe.  Expr17 ::= TokCompareRatTensorPointwiseLe;
CompareRatTensorPointwiseLt.  Expr17 ::= TokCompareRatTensorPointwiseLt;
CompareRatTensorPointwiseGe.  Expr17 ::= TokCompareRatTensorPointwiseGe;
CompareRatTensorPointwiseGt.  Expr17 ::= TokCompareRatTensorPointwiseGt;
CompareRatTensorReducedEq.    Expr17 ::= TokCompareRatTensorReducedEq;
CompareRatTensorReducedNe.    Expr17 ::= TokCompareRatTensorReducedNe;
CompareRatTensorReducedLe.    Expr17 ::= TokCompareRatTensorReducedLe;
CompareRatTensorReducedLt.    Expr17 ::= TokCompareRatTensorReducedLt;
CompareRatTensorReducedGe.    Expr17 ::= TokCompareRatTensorReducedGe;
CompareRatTensorReducedGt.    Expr17 ::= TokCompareRatTensorReducedGt;

Nil.           Expr17 ::= TokNil;
Append.        Expr17 ::= TokAppend;
Const.         Expr17 ::= TokConst;
Transpose.     Expr17 ::= TokTranspose;
Map.           Expr17 ::= TokMap;
Fold.          Expr17 ::= TokFold;
ReduceOr.      Expr17 ::= TokReduceOr;
ReduceAnd.     Expr17 ::= TokReduceAnd;
ReduceAdd.     Expr17 ::= TokReduceAdd;
ReduceMul.     Expr17 ::= TokReduceMul;
ReduceMin.     Expr17 ::= TokReduceMin;
ReduceMax.     Expr17 ::= TokReduceMax;
Unit.          Expr17 ::= TokUnit;
Bool.          Expr17 ::= TokBool;
Index.         Expr17 ::= TokIndex;
Nat.           Expr17 ::= TokNat;
Real.          Expr17 ::= TokReal;
List.          Expr17 ::= TokList;
Vector.        Expr17 ::= TokVector;
Tensor.        Expr17 ::= TokTensor;
HasMap.        Expr17 ::= TokHasMap;
HasFold.       Expr17 ::= TokHasFold;
IsTensorType.  Expr17 ::= TokIsTensorType;
NonCastingTensor. Expr17 ::= TokNonCastingTensor;
NonCastingReal. Expr17 ::= TokNonCastingReal;

coercions Expr 17;
separator Expr ",";

-- * Annotation options

NameAnnOption.    DeclAnnOption ::= TokAnnNameOpt "=" Name;
InferAnnOption.   DeclAnnOption ::= TokAnnInferOpt "=" Boolean;
DefaultAnnOption. DeclAnnOption ::= TokAnnDefaultOpt "=" Natural;
TypeAnnOption.    DeclAnnOption ::= Name "=" Expr;

separator DeclAnnOption ",";

-- * Declarations annotations

DeclAnnWithOpts.    DeclAnnOpts ::= "(" [DeclAnnOption] ")";
DeclAnnWithoutOpts. DeclAnnOpts ::= "";

-- * Declarations

DefAnn.       Decl ::= TokAnnotation DeclAnnOpts;
DefType.      Decl ::= "type" Name [NameBinder] "=" Expr;
DefFunType.   Decl ::= Name TokElemOf Expr;
DefFunExpr.   Decl ::= Name [NameBinder] "=" Expr;
DefRecord.    Decl ::= "record" Name [NameBinder] "where" "{" [RecordFieldDef] "}" RecordSupports;

Supports.   RecordSupports ::= "supports" [Name];
NoSupports. RecordSupports ::= "";

separator Decl ";";

-- * Import statements

ModulePathFrag. ModulePathFragment ::= Name;

separator nonempty ModulePathFragment ".";

Import. ImportStatement ::= "import" [ModulePathFragment];

separator ImportStatement ";";

-- * Module

layout toplevel;

layout stop "}";

DefModule. Module ::= [ImportStatement] [Decl]
