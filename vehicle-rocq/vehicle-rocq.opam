opam-version: "2.0"
version: "0.1.0"
maintainer: [
  "Alessandro Bruni <brun@itu.dk>"
  "Alistair Sirman <A.Sirman@soton.ac.uk>"
]

homepage: "https://github.com/vehicle-lang/vehicle"
bug-reports: "https://github.com/vehicle-lang/vehicle/issues"
dev-repo: "https://github.com/vehicle-lang/vehicle.git"
license: "BSD-3-Clause"

synopsis: "Companion library for vehicle to Rocq compilation"
description: """
This library contains definitions used by the Vehicle to Rocq compiler,
users should include this library when working with Vehicle-generated Rocq files.
It also provides the vehicle_validate tactic, which invokes
`vehicle validate --cache=<path>` at proof-checking time to discharge
@property obligations against a pre-computed verification cache.
"""

build: [
  [ make "-C" "utils" "-j" jobs]
  [ "dune" "build" "-p" name "-j" jobs ]
]
install: [
  [make "-C" "utils" "install"]
  [ "dune" "install" "-p" name ]
]
depends: [
  "dune" {>= "3.13"}
  "rocq-core" {>= "9.0"}
  "rocq-mathcomp-ssreflect" { >= "2.6.0" }
  "rocq-mathcomp-algebra" { >= "2.6.0" }
  "rocq-mathcomp-reals" { >= "1.14.0" }
]

authors: [
  "Joshua Smart"
  "Alessandro Bruni"
]
