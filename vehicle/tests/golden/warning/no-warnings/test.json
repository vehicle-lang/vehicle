[
  {
    "name": "Marabou",
    "run": "vehicle compile -s spec.vcl -t MarabouQueries -o Marabou.queries/ --network f:fake.onnx --no-warnings",
    "needs": [
      "spec.vcl",
      "fake.onnx"
    ],
    "produces": [
      "Marabou.queries/p!0-query1.txt",
      "Marabou.queries/p!1.vcl-plan",
      "Marabou.queries/p!0.vcl-plan"
    ],
    "ignore": {
      "lines": ".*\"fileHash\".*"
    },
    "sizeOnly": ".vcl-plan"
  }
]
