VehicleLoss : DifferentiableTensorLogic;
VehicleLoss = {trueElement = - infinity, falseElement = infinity, pointwiseNegation = \dims -> \x -> - x, pointwiseConjunction = \dims -> \x -> \y -> max x y, pointwiseDisjunction = \dims -> \x -> \y -> min x y, pointwiseLessThan = \dims -> \x -> \y -> x - y, pointwiseLessEqualThan = \dims -> \x -> \y -> x - y, pointwiseGreaterThan = \dims -> \x -> \y -> y - x, pointwiseGreaterEqualThan = \dims -> \x -> \y -> y - x, pointwiseEqual = \dims -> \x -> \y -> min (x - y) (y - x), pointwiseNotEqual = \dims -> \x -> \y -> max (x - y) (y - x), reduceConjunction = \dims -> \xs -> reduceMax xs, reduceDisjunction = \dims -> \xs -> reduceMin xs} 

@property;
robustAround : (Tensor Real -> Tensor Real) -> Tensor Real;
robustAround classifier = VehicleLoss.pointwiseNegation nil (search [1] (const -infinity [1]) (const infinity [1]) (\delta -> VehicleLoss.reduceDisjunction [1] (VehicleLoss.pointwiseLessThan nil (const 0.0 [1]) (classifier (foreach k. delta ! k)))))
