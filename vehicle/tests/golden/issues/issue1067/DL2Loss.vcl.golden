@property;
boundedRobust : (Tensor Real -> Tensor Real) -> Tensor Real;
boundedRobust = \ f -> 1.0 / search[x] (\ dims -> \ xs -> reduceMul xs) [1] (const -1.0 [1]) (const 1.0 [1]) (\ x -> search[x_hat] (\ dims -> \ xs -> reduceMul xs) [1] (const -1.0 [1]) (const 1.0 [1]) (\ x_hat -> reduceAdd (max (const 0.0 [1]) (f x - f x_hat - (const -1.0 [1]))) * reduceAdd (max (const 0.0 [1]) ((const 1.0 [1]) - (f x - f x_hat)))))