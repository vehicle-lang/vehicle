@property;
boundedRobust : (Tensor Real -> Tensor Real) -> Tensor Real;
boundedRobust = \ f -> [ 1.0 ] / search[x] (\ e -> \ xs -> reduceMul e xs) [1] [ -1.0 ] [ 1.0 ] (\ x -> search[x_hat] (\ e -> \ xs -> reduceMul e xs) [1] [ -1.0 ] [ 1.0 ] (\ x_hat -> max [ 0.0 ] (f x_hat - f x - [ -1.0 ]) * max [ 0.0 ] ([ 1.0 ] - (f x_hat - f x))))