@property;
boundedByEpsilonFactor : (Tensor Real -> Tensor Real) -> Tensor Real -> Tensor Real -> Tensor Real;
boundedByEpsilonFactor = \ net -> \ epsilon -> \ factor -> 1.0 / search[x] (\ xs -> reduceMul xs) [1] [-1.0 * epsilon * factor] [-1.0 * (-1.0 * (epsilon * factor))] (\ x -> max 0.0 (net x ! 0 - - (epsilon / factor)) * max 0.0 (epsilon / factor - net x ! 0))