VehicleLoss : DifferentiableTensorLogic;
VehicleLoss = {trueElement = - infinity, falseElement = infinity, pointwiseNegation = \dims -> \x -> - x, pointwiseConjunction = \dims -> \x -> \y -> max x y, pointwiseDisjunction = \dims -> \x -> \y -> min x y, pointwiseLessThan = \dims -> \x -> \y -> x - y, pointwiseLessEqualThan = \dims -> \x -> \y -> x - y, pointwiseGreaterThan = \dims -> \x -> \y -> y - x, pointwiseGreaterEqualThan = \dims -> \x -> \y -> y - x, pointwiseEqual = \dims -> \x -> \y -> min (x - y) (y - x), pointwiseNotEqual = \dims -> \x -> \y -> max (x - y) (y - x), reduceConjunction = \dims -> \xs -> reduceMax xs, reduceDisjunction = \dims -> \xs -> reduceMin xs} 

@property;
p : (Tensor Real -> Tensor Real) -> Tensor Real;
p f = VehicleLoss.pointwiseNegation [] (search [2] (const -infinity [2]) (const infinity [2]) (\x -> VehicleLoss.pointwiseNegation [] (VehicleLoss.pointwiseDisjunction [] (VehicleLoss.pointwiseNegation [] (VehicleLoss.pointwiseGreaterEqualThan [] (x ! 0) (x ! 1))) (VehicleLoss.pointwiseGreaterEqualThan [] (f x) 0.5))))

@property;
q : (Tensor Real -> Tensor Real) -> Tensor Real;
q f = VehicleLoss.pointwiseNegation [] (search [2] (const -infinity [2]) (const infinity [2]) (\x -> VehicleLoss.pointwiseNegation [] (VehicleLoss.pointwiseDisjunction [] (VehicleLoss.pointwiseNegation [] (VehicleLoss.reduceConjunction [2] (foreach i. VehicleLoss.pointwiseLessEqualThan [] (x ! 0) (x ! i)))) (VehicleLoss.pointwiseGreaterEqualThan [] (f x) 0.5))))

@property;
r : (Tensor Real -> Tensor Real) -> Tensor Real;
r f = VehicleLoss.pointwiseNegation [] (search [2] (const -infinity [2]) (const infinity [2]) (\x -> search [2] (const -infinity [2]) (const infinity [2]) (\y -> VehicleLoss.pointwiseNegation [] (VehicleLoss.pointwiseDisjunction [] (VehicleLoss.pointwiseNegation [] (VehicleLoss.reduceConjunction [2] (foreach i. VehicleLoss.pointwiseLessEqualThan [] (x ! i) (y ! 0)))) (VehicleLoss.pointwiseGreaterEqualThan [] (f x) (f y))))))
