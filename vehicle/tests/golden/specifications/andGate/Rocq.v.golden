Parameter R : realType.

Parameter andGate : 'nT[R]_[2] -> 'nT[R]_[1].

Definition truthy (x : 'sT[R]) : Prop := x >= const_t (1 / 2 : R).

Definition falsey (x : 'sT[R]) : Prop := x <= const_t (1 / 2 : R).

Definition validInput (x : 'sT[R]) : Prop := const_t (0 : R) <= x /\ x <= const_t (1 : R).

