DL2Loss : DifferentiableTensorLogic;
DL2Loss = {trueElement = 0.0, falseElement = infinity, pointwiseNegation = \ dims -> \ x -> const 1.0 dims / x, pointwiseConjunction = \ dims -> \ x -> \ y -> x + y, pointwiseDisjunction = \ dims -> \ x -> \ y -> x * y, pointwiseLessThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (x - y), pointwiseLessEqualThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (x - y), pointwiseGreaterThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (y - x), pointwiseGreaterEqualThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (y - x), pointwiseEqual = \ dims -> \ x -> \ y -> - (max (const 0.0 dims) (x - y) + max (const 0.0 dims) (y - x)), pointwiseNotEqual = \ dims -> \ x -> \ y -> max (const 0.0 dims) (x - y) + max (const 0.0 dims) (y - x), reduceConjunction = \ dims -> \ xs -> reduceAdd xs, reduceDisjunction = \ dims -> \ xs -> reduceMul xs} 

@property;
andGateCorrect : (Tensor Real -> Tensor Real) -> Tensor Real;
andGateCorrect = \ andGate -> DL2Loss.pointwiseNegation nil (DL2Loss.pointwiseDisjunction nil (search nil 0.0 0.5 (\ x1 -> DL2Loss.pointwiseDisjunction nil (search nil 0.5 1.0 (\ x2 -> DL2Loss.pointwiseGreaterThan nil (andGate [x1, x2] ! 0) 0.5)) (search nil 0.0 0.5 (\ x2 -> DL2Loss.pointwiseGreaterThan nil (andGate [x1, x2] ! 0) 0.5)))) (search nil 0.5 1.0 (\ x1 -> DL2Loss.pointwiseDisjunction nil (search nil 0.0 0.5 (\ x2 -> DL2Loss.pointwiseGreaterThan nil (andGate [x1, x2] ! 0) 0.5)) (search nil 0.5 1.0 (\ x2 -> DL2Loss.pointwiseLessThan nil (andGate [x1, x2] ! 0) 0.5)))))