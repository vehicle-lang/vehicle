DL2Loss : DifferentiableTensorLogic;
DL2Loss = {trueElement = 0.0, falseElement = infinity, pointwiseNegation = \dims -> \x -> const 1.0 dims / x, pointwiseConjunction = \dims -> \x -> \y -> x + y, pointwiseDisjunction = \dims -> \x -> \y -> x * y, pointwiseLessThan = \dims -> \x -> \y -> max (const 0.0 dims) (x - y), pointwiseLessEqualThan = \dims -> \x -> \y -> max (const 0.0 dims) (x - y), pointwiseGreaterThan = \dims -> \x -> \y -> max (const 0.0 dims) (y - x), pointwiseGreaterEqualThan = \dims -> \x -> \y -> max (const 0.0 dims) (y - x), pointwiseEqual = \dims -> \x -> \y -> max (x - y) (y - x), pointwiseNotEqual = \dims -> \x -> \y -> const 1.0 dims / max (x - y) (y - x), reduceConjunction = \dims -> \xs -> reduceAdd xs, reduceDisjunction = \dims -> \xs -> reduceMul xs} 

truthy : Tensor Real -> Tensor Real;
truthy x = DL2Loss.pointwiseGreaterEqualThan nil x 0.5

falsey : Tensor Real -> Tensor Real;
falsey x = DL2Loss.pointwiseLessEqualThan nil x 0.5

@property;
andGateCorrect : (Tensor Real -> Tensor Real) -> Tensor Real;
andGateCorrect andGate = DL2Loss.pointwiseNegation nil (DL2Loss.pointwiseDisjunction nil (search nil 0.0 0.5 (\x1 -> DL2Loss.pointwiseDisjunction nil (search nil 0.5 1.0 (\x2 -> DL2Loss.pointwiseNegation nil (falsey (andGate [x1, x2] ! 0)))) (search nil 0.0 0.5 (\x2 -> DL2Loss.pointwiseNegation nil (falsey (andGate [x1, x2] ! 0)))))) (search nil 0.5 1.0 (\x1 -> DL2Loss.pointwiseDisjunction nil (search nil 0.0 0.5 (\x2 -> DL2Loss.pointwiseNegation nil (falsey (andGate [x1, x2] ! 0)))) (search nil 0.5 1.0 (\x2 -> DL2Loss.pointwiseNegation nil (truthy (andGate [x1, x2] ! 0)))))))