DL2Loss : DifferentiableTensorLogic;
DL2Loss = {trueElement = 0.0, falseElement = infinity, pointwiseNegation = \dims -> \x -> const 1.0 dims / x, pointwiseConjunction = \dims -> \x -> \y -> x + y, pointwiseDisjunction = \dims -> \x -> \y -> x * y, pointwiseLessThan = \dims -> \x -> \y -> max (const 0.0 dims) (x - y), pointwiseLessEqualThan = \dims -> \x -> \y -> max (const 0.0 dims) (x - y), pointwiseGreaterThan = \dims -> \x -> \y -> max (const 0.0 dims) (y - x), pointwiseGreaterEqualThan = \dims -> \x -> \y -> max (const 0.0 dims) (y - x), pointwiseEqual = \dims -> \x -> \y -> max (x - y) (y - x), pointwiseNotEqual = \dims -> \x -> \y -> const 1.0 dims / max (x - y) (y - x), reduceConjunction = \dims -> \xs -> reduceAdd xs, reduceDisjunction = \dims -> \xs -> reduceMul xs} 

@network;
controller : Tensor Real -> Tensor Real

@property;
safe_0 : Tensor Real;
safe_0 = search [2] (const -3.25 [2]) (const 3.25 [2]) (\x -> DL2Loss.reduceDisjunction nil (DL2Loss.pointwiseGreaterEqualThan nil (- 1.25) (controller (foreach i. (x ! i + 4.0) / 8.0) ! 0 + 2.0 * x ! 0 - x ! 1)))

@property;
safe_1 : Tensor Real;
safe_1 = search [2] (const -3.25 [2]) (const 3.25 [2]) (\x -> DL2Loss.reduceDisjunction nil (DL2Loss.pointwiseGreaterEqualThan nil (controller (foreach i. (x ! i + 4.0) / 8.0) ! 0 + 2.0 * x ! 0 - x ! 1) 1.25))

@property;
safe_0_bool : Tensor Bool;
safe_0_bool = \x -> reduceAnd (foreach k. - 3.25 <= x ! k and x ! k <= 3.25) and reduceOr (- 1.25 >= controller (foreach i. (x ! i + 4.0) / 8.0) ! 0 + 2.0 * x ! 0 - x ! 1)

@property;
safe_1_bool : Tensor Bool;
safe_1_bool = \x -> reduceAnd (foreach k. - 3.25 <= x ! k and x ! k <= 3.25) and reduceOr (controller (foreach i. (x ! i + 4.0) / 8.0) ! 0 + 2.0 * x ! 0 - x ! 1 >= 1.25)