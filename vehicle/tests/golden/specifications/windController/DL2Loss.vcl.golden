@property;
safe : (Tensor Real -> Tensor Real) -> Tensor Real;
safe = \ controller -> const 1.0 nil / search[x] [2] (\ dims -> \ xs -> reduceMul xs) (const -3.25 [2]) (const 3.25 [2]) (\ x -> max (const 0.0 nil) (controller ((x + (const 4.0 [2])) / (const 8.0 [2])) ! 0 + 2.0 * x ! 0 - x ! 1 - - 1.25) * max (const 0.0 nil) (1.25 - (controller ((x + (const 4.0 [2])) / (const 8.0 [2])) ! 0 + 2.0 * x ! 0 - x ! 1)))