DL2Loss : DifferentiableTensorLogic;
DL2Loss = {trueElement = 0.0, falseElement = infinity, pointwiseNegation = \dims -> \x -> const 1.0 dims / x, pointwiseConjunction = \dims -> \x -> \y -> x + y, pointwiseDisjunction = \dims -> \x -> \y -> x * y, pointwiseLessThan = \dims -> \x -> \y -> max (const 0.0 dims) (x - y), pointwiseLessEqualThan = \dims -> \x -> \y -> max (const 0.0 dims) (x - y), pointwiseGreaterThan = \dims -> \x -> \y -> max (const 0.0 dims) (y - x), pointwiseGreaterEqualThan = \dims -> \x -> \y -> max (const 0.0 dims) (y - x), pointwiseEqual = \dims -> \x -> \y -> max (x - y) (y - x), pointwiseNotEqual = \dims -> \x -> \y -> const 1.0 dims / max (x - y) (y - x), reduceConjunction = \dims -> \xs -> reduceAdd xs, reduceDisjunction = \dims -> \xs -> reduceMul xs} 

currentSensor : Index;
currentSensor = 0

previousSensor : Index;
previousSensor = 1

velocity : Index;
velocity = 0

normalise : Tensor Real -> Tensor Real;
normalise x = foreach i. (x ! i + 4.0) / 8.0

safeOutput : (Tensor Real -> Tensor Real) -> Tensor Real -> Tensor Real;
safeOutput controller x = let y = controller (normalise x) ! velocity in DL2Loss.pointwiseConjunction nil (DL2Loss.pointwiseLessThan nil (- 1.25) (y + 2.0 * x ! currentSensor - x ! previousSensor)) (DL2Loss.pointwiseLessThan nil (y + 2.0 * x ! currentSensor - x ! previousSensor) 1.25)

@property;
safe : (Tensor Real -> Tensor Real) -> Tensor Real;
safe controller = DL2Loss.pointwiseNegation nil (search [2] (const -3.25 [2]) (const 3.25 [2]) (\x -> DL2Loss.pointwiseNegation nil (safeOutput controller x)))