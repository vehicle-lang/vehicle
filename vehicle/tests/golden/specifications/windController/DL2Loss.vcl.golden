@property;
safe : (Tensor Real -> Tensor Real) -> Tensor Real;
safe = \ controller -> 1.0 / search[x] (\ xs -> reduceMul xs) [2] (const -3.25 [2]) (const 3.25 [2]) (\ x -> max 0.0 (controller ((x + (const 4.0 [2])) / (const 8.0 [2])) ! 0 + 2.0 * x ! 0 - x ! 1 - -1.25) * max 0.0 (1.25 - (controller ((x + (const 4.0 [2])) / (const 8.0 [2])) ! 0 + 2.0 * x ! 0 - x ! 1)))