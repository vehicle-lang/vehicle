DL2Loss : DifferentiableTensorLogic;
DL2Loss = {trueElement = 0.0, falseElement = infinity, pointwiseNegation = \ dims -> \ x -> const 1.0 dims / x, pointwiseConjunction = \ dims -> \ x -> \ y -> x + y, pointwiseDisjunction = \ dims -> \ x -> \ y -> x * y, pointwiseLessThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (x - y), pointwiseLessEqualThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (x - y), pointwiseGreaterThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (y - x), pointwiseGreaterEqualThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (y - x), pointwiseEqual = \ dims -> \ x -> \ y -> - (max (const 0.0 dims) (x - y) + max (const 0.0 dims) (y - x)), pointwiseNotEqual = \ dims -> \ x -> \ y -> max (const 0.0 dims) (x - y) + max (const 0.0 dims) (y - x), reduceConjunction = \ dims -> \ xs -> reduceAdd xs, reduceDisjunction = \ dims -> \ xs -> reduceMul xs} 

robustAround : (Tensor Real -> Tensor Real) -> Tensor Real -> Tensor Real -> Index -> Tensor Real;
robustAround = \ classifier -> \ epsilon -> \ image -> \ label -> DL2Loss.pointwiseNegation nil (search [2, 2] (const -1.0 [2, 2] * const epsilon [2, 2]) (const -1.0 [2, 2] * (const -1.0 [2, 2] * const epsilon [2, 2])) (\ perturbation -> where (DL2Loss.reduceDisjunction [3] (DL2Loss.pointwiseNegation [3] (where (DL2Loss.pointwiseGreaterThan nil (const (classifier (image - perturbation) ! label) [3]) (classifier (image - perturbation))) (not [0 != label, 1 != label, 2 != label]) (DL2Loss.trueElement)))) (const 0.0 [2, 2] <= image - perturbation and image - perturbation <= const 1.0 [2, 2]) (DL2Loss.trueElement)))

n : Nat;
n = 1

trainingImages : Vector (Tensor Real);
trainingImages = [[ [ 1.0, 2.0 ], [ 3.0, 4.0 ] ]]

trainingLabels : Vector Index;
trainingLabels = [0]

@property;
robust : (Tensor Real -> Tensor Real) -> Tensor Real -> Vector (Tensor Real);
robust = \ classifier -> \ epsilon -> foreach i. robustAround classifier epsilon (trainingImages ! i) (trainingLabels ! i)