DL2Loss : DifferentiableTensorLogic;
DL2Loss = {trueElement = 0.0, falseElement = infinity, pointwiseNegation = \dims -> \x -> const 1.0 dims / x, pointwiseConjunction = \dims -> \x -> \y -> x + y, pointwiseDisjunction = \dims -> \x -> \y -> x * y, pointwiseLessThan = \dims -> \x -> \y -> max (const 0.0 dims) (x - y), pointwiseLessEqualThan = \dims -> \x -> \y -> max (const 0.0 dims) (x - y), pointwiseGreaterThan = \dims -> \x -> \y -> max (const 0.0 dims) (y - x), pointwiseGreaterEqualThan = \dims -> \x -> \y -> max (const 0.0 dims) (y - x), pointwiseEqual = \dims -> \x -> \y -> max (x - y) (y - x), pointwiseNotEqual = \dims -> \x -> \y -> const 1.0 dims / max (x - y) (y - x), reduceConjunction = \dims -> \xs -> reduceAdd xs, reduceDisjunction = \dims -> \xs -> reduceMul xs} 

advises : (Tensor Real -> Tensor Real) -> Tensor Real -> Index -> Tensor Real;
advises classifier x i = DL2Loss.reduceConjunction [3] (foreach k. where (DL2Loss.pointwiseGreaterThan nil (classifier x ! i) (classifier x ! k)) (not (k != i)) (DL2Loss.trueElement))

robustAround : (Tensor Real -> Tensor Real) -> Tensor Real -> Tensor Real -> Index -> Tensor Real;
robustAround classifier epsilon image label = DL2Loss.pointwiseNegation nil (search [2, 2] (max (image + const -1.0 [2, 2]) (const (- epsilon) [2, 2])) (min image (const epsilon [2, 2])) (\perturbation -> DL2Loss.pointwiseNegation nil (advises classifier (image - perturbation) label)))

n : Nat;
n = 1

trainingImages : Vector (Tensor Real);
trainingImages = [[ [ 1.0, 2.0 ], [ 3.0, 4.0 ] ]]

trainingLabels : Vector Index;
trainingLabels = [0]

@property;
robust : (Tensor Real -> Tensor Real) -> Tensor Real -> Vector (Tensor Real);
robust classifier epsilon = foreach i. robustAround classifier epsilon (trainingImages ! i) (trainingLabels ! i)