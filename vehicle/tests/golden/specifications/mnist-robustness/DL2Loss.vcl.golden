DL2Loss : DifferentiableTensorLogic;
DL2Loss = {trueElement = 0.0, falseElement = infinity, pointwiseNegation = \ dims -> \ x -> const 1.0 dims / x, pointwiseConjunction = \ dims -> \ x -> \ y -> x + y, pointwiseDisjunction = \ dims -> \ x -> \ y -> x * y, pointwiseLessThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (x - y), pointwiseLessEqualThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (x - y), pointwiseGreaterThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (y - x), pointwiseGreaterEqualThan = \ dims -> \ x -> \ y -> max (const 0.0 dims) (y - x), pointwiseEqual = \ dims -> \ x -> \ y -> max (x - y) (y - x), pointwiseNotEqual = \ dims -> \ x -> \ y -> const 1.0 dims / max (x - y) (y - x), reduceConjunction = \ dims -> \ xs -> reduceAdd xs, reduceDisjunction = \ dims -> \ xs -> reduceMul xs} 

robustAround : (Tensor Real -> Tensor Real) -> Tensor Real -> Tensor Real -> Index -> Tensor Real;
robustAround = \ classifier -> \ epsilon -> \ image -> \ label -> DL2Loss.pointwiseNegation nil (search [28, 28] (const -1.0 [28, 28] * const epsilon [28, 28]) (const -1.0 [28, 28] * (const -1.0 [28, 28] * const epsilon [28, 28])) (\ perturbation -> where (DL2Loss.reduceDisjunction [10] (DL2Loss.pointwiseNegation [10] (where (DL2Loss.pointwiseGreaterThan nil (const (classifier (image - perturbation) ! label) [10]) (classifier (image - perturbation))) (not [0 != label, 1 != label, 2 != label, 3 != label, 4 != label, 5 != label, 6 != label, 7 != label, 8 != label, 9 != label]) (DL2Loss.trueElement)))) (const 0.0 [28, 28] <= image - perturbation and image - perturbation <= const 1.0 [28, 28]) (DL2Loss.trueElement)))

@property;
robust : Nat -> (Tensor Real -> Tensor Real) -> Tensor Real -> (Nat -> Vector (Tensor Real)) -> (Nat -> Vector Index) -> Vector (Tensor Real);
robust = \ n -> \ classifier -> \ epsilon -> \ trainingImages -> \ trainingLabels -> foreach i. robustAround classifier epsilon (trainingImages ! i) (trainingLabels ! i)