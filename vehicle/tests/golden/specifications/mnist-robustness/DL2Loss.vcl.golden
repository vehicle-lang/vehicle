@property;
robust : Nat -> (Tensor Real -> Tensor Real) -> Tensor Real -> (Nat -> Vector (Tensor Real)) -> (Nat -> Vector Index) -> Vector (Tensor Real);
robust = \ n -> \ classifier -> \ epsilon -> \ trainingImages -> \ trainingLabels -> foreach i . [ [ 1.0 ] ] / search[perturbation] (\ e -> \ xs -> reduceMul e xs) [1, 1] [max (trainingImages ! i ! 0 + [ -1.0 ]) [- epsilon]] [min ([ -1.0 ] * ([ -1.0 ] * trainingImages ! i ! 0)) [-1.0 * (-1.0 * epsilon)]] (\ perturbation -> reduceMul infinity ([max 0.0 (0.0 - trainingLabels ! i) + max 0.0 (trainingLabels ! i), max 0.0 (1.0 - trainingLabels ! i) + max 0.0 (trainingLabels ! i - 1.0)] + max [ 0.0, 0.0 ] ([classifier (trainingImages ! i - perturbation) ! (trainingLabels ! i), classifier (trainingImages ! i - perturbation) ! (trainingLabels ! i)] - classifier (trainingImages ! i - perturbation))))