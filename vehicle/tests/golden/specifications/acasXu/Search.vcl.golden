DL2Loss : DifferentiableTensorLogic;
DL2Loss = {trueElement = 0.0, falseElement = infinity, pointwiseNegation = \dims -> \x -> const 1.0 dims / x, pointwiseConjunction = \dims -> \x -> \y -> x + y, pointwiseDisjunction = \dims -> \x -> \y -> x * y, pointwiseLessThan = \dims -> \x -> \y -> max (const 0.0 dims) (x - y), pointwiseLessEqualThan = \dims -> \x -> \y -> max (const 0.0 dims) (x - y), pointwiseGreaterThan = \dims -> \x -> \y -> max (const 0.0 dims) (y - x), pointwiseGreaterEqualThan = \dims -> \x -> \y -> max (const 0.0 dims) (y - x), pointwiseEqual = \dims -> \x -> \y -> max (x - y) (y - x), pointwiseNotEqual = \dims -> \x -> \y -> const 1.0 dims / max (x - y) (y - x), reduceConjunction = \dims -> \xs -> reduceAdd xs, reduceDisjunction = \dims -> \xs -> reduceMul xs} 

pi : Tensor Real;
pi = 3.141592

clearOfConflict : Index;
clearOfConflict = 0

weakLeft : Index;
weakLeft = 1

strongLeft : Index;
strongLeft = 3

strongRight : Index;
strongRight = 4

@network;
acasXu : Tensor Real -> Tensor Real

minimumInputValues : Tensor Real;
minimumInputValues = [0.0, - pi, - pi, 100.0, 0.0]

maximumInputValues : Tensor Real;
maximumInputValues = [60261.0, pi, pi, 1200.0, 1200.0]

meanScalingValues : Tensor Real;
meanScalingValues = [ 19791.091, 0.0, 0.0, 650.0, 600.0 ]

normalise : Tensor Real -> Tensor Real;
normalise x = foreach i. (x ! i - meanScalingValues ! i) / (maximumInputValues ! i - minimumInputValues ! i)

normAcasXu : Tensor Real -> Tensor Real;
normAcasXu x = acasXu (normalise x)

