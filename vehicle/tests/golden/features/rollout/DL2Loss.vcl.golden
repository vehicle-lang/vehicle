@property;
positionStaysSmall : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
positionStaysSmall = \ controller -> \ dynamics -> max 0.0 ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 0 ! 0 - 10.0) + max 0.0 ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 1 ! 0 - 10.0) + max 0.0 ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 2 ! 0 - 10.0) + max 0.0 ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 3 ! 0 - 10.0)

@property;
stateInBounds : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
stateInBounds = \ controller -> \ dynamics -> reduceAdd 0.0 (max [ 0.0, 0.0 ] ([ -10.0, -10.0 ] - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 0)) + reduceAdd 0.0 (max [ 0.0, 0.0 ] ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 0 - [ 10.0, 10.0 ])) + (reduceAdd 0.0 (max [ 0.0, 0.0 ] ([ -10.0, -10.0 ] - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 1)) + reduceAdd 0.0 (max [ 0.0, 0.0 ] ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 1 - [ 10.0, 10.0 ]))) + (reduceAdd 0.0 (max [ 0.0, 0.0 ] ([ -10.0, -10.0 ] - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 2)) + reduceAdd 0.0 (max [ 0.0, 0.0 ] ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 2 - [ 10.0, 10.0 ]))) + (reduceAdd 0.0 (max [ 0.0, 0.0 ] ([ -10.0, -10.0 ] - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 3)) + reduceAdd 0.0 (max [ 0.0, 0.0 ] ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 3 - [ 10.0, 10.0 ])))

@property;
boundedInitVel : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
boundedInitVel = \ controller -> \ dynamics -> search[v] (\ e -> \ xs -> reduceMul e xs) nil 0.0 1.0 (\ v -> max 0.0 ((rollout [4] controller dynamics [0.0, v]) ! 0 ! 0 - 10.0) + max 0.0 ((rollout [4] controller dynamics [0.0, v]) ! 1 ! 0 - 10.0) + max 0.0 ((rollout [4] controller dynamics [0.0, v]) ! 2 ! 0 - 10.0) + max 0.0 ((rollout [4] controller dynamics [0.0, v]) ! 3 ! 0 - 10.0))