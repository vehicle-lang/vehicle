@property;
positionStaysSmall : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
positionStaysSmall = \ controller -> \ dynamics -> (\ __rollout_0 -> - reduceMin 1000000.0 ([ 10.0, 10.0, 10.0, 10.0 ] - (foreach i . __rollout_0 ! i ! 0))) (stlRollout 4 controller dynamics [ 0.0, 0.0 ])

@property;
stateInBounds : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
stateInBounds = \ controller -> \ dynamics -> (\ __rollout_0 -> - min (reduceMin 1000000.0 (__rollout_0 - [ [ -10.0, -10.0 ], [ -10.0, -10.0 ], [ -10.0, -10.0 ], [ -10.0, -10.0 ] ])) (reduceMin 1000000.0 ([ [ 10.0, 10.0 ], [ 10.0, 10.0 ], [ 10.0, 10.0 ], [ 10.0, 10.0 ] ] - __rollout_0))) (stlRollout 4 controller dynamics [ 0.0, 0.0 ])

@property;
boundedInitVel : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
boundedInitVel = \ controller -> \ dynamics -> - search[v] (\ e -> \ xs -> reduceMax e xs) nil 0.0 1.0 (\ v -> (\ __rollout_0 -> reduceMin 1000000.0 ([ 10.0, 10.0, 10.0, 10.0 ] - (foreach i . __rollout_0 ! i ! 0))) (stlRollout 4 controller dynamics [0.0, v]))