@property;
positionStaysSmall : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
positionStaysSmall = \ controller -> \ dynamics -> (\ __rollout_0 -> - min (min (min (10.0 - __rollout_0 ! 0 ! 0) (10.0 - __rollout_0 ! 1 ! 0)) (10.0 - __rollout_0 ! 2 ! 0)) (10.0 - __rollout_0 ! 3 ! 0)) (rollout [4] controller dynamics [ 0.0, 0.0 ])

@property;
stateInBounds : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
stateInBounds = \ controller -> \ dynamics -> (\ __rollout_0 -> - min (min (min (min (reduceMin 1000000.0 (__rollout_0 ! 0 - [ -10.0, -10.0 ])) (reduceMin 1000000.0 ([ 10.0, 10.0 ] - __rollout_0 ! 0))) (min (reduceMin 1000000.0 (__rollout_0 ! 1 - [ -10.0, -10.0 ])) (reduceMin 1000000.0 ([ 10.0, 10.0 ] - __rollout_0 ! 1)))) (min (reduceMin 1000000.0 (__rollout_0 ! 2 - [ -10.0, -10.0 ])) (reduceMin 1000000.0 ([ 10.0, 10.0 ] - __rollout_0 ! 2)))) (min (reduceMin 1000000.0 (__rollout_0 ! 3 - [ -10.0, -10.0 ])) (reduceMin 1000000.0 ([ 10.0, 10.0 ] - __rollout_0 ! 3)))) (rollout [4] controller dynamics [ 0.0, 0.0 ])

@property;
boundedInitVel : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
boundedInitVel = \ controller -> \ dynamics -> - search[v] (\ e -> \ xs -> reduceMax e xs) nil 0.0 1.0 (\ v -> (\ __rollout_0 -> min (min (min (10.0 - __rollout_0 ! 0 ! 0) (10.0 - __rollout_0 ! 1 ! 0)) (10.0 - __rollout_0 ! 2 ! 0)) (10.0 - __rollout_0 ! 3 ! 0)) (rollout [4] controller dynamics [0.0, v]))