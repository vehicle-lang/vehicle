@property;
positionStaysSmall : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
positionStaysSmall = \ controller -> \ dynamics -> min (min (min (10.0 - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 0 ! 0) (10.0 - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 1 ! 0)) (10.0 - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 2 ! 0)) (10.0 - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 3 ! 0)

@property;
stateInBounds : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
stateInBounds = \ controller -> \ dynamics -> min (min (min (min (reduceMin 1000000.0 ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 0 - [ -10.0, -10.0 ])) (reduceMin 1000000.0 ([ 10.0, 10.0 ] - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 0))) (min (reduceMin 1000000.0 ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 1 - [ -10.0, -10.0 ])) (reduceMin 1000000.0 ([ 10.0, 10.0 ] - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 1)))) (min (reduceMin 1000000.0 ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 2 - [ -10.0, -10.0 ])) (reduceMin 1000000.0 ([ 10.0, 10.0 ] - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 2)))) (min (reduceMin 1000000.0 ((rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 3 - [ -10.0, -10.0 ])) (reduceMin 1000000.0 ([ 10.0, 10.0 ] - (rollout [4] controller dynamics [ 0.0, 0.0 ]) ! 3)))

@property;
boundedInitVel : (Tensor Real -> Tensor Real) -> (Tensor Real -> Tensor Real -> Tensor Real) -> Tensor Real;
boundedInitVel = \ controller -> \ dynamics -> search[v] (\ e -> \ xs -> reduceMax e xs) nil 0.0 1.0 (\ v -> min (min (min (10.0 - (rollout [4] controller dynamics [0.0, v]) ! 0 ! 0) (10.0 - (rollout [4] controller dynamics [0.0, v]) ! 1 ! 0)) (10.0 - (rollout [4] controller dynamics [0.0, v]) ! 2 ! 0)) (10.0 - (rollout [4] controller dynamics [0.0, v]) ! 3 ! 0))