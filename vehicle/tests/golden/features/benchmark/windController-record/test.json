[
    {
        "name": "TypeCheck",
        "run": "vehicle typecheck -s windController-record.vcl",
        "needs": [
            "windController-record.vcl"
        ]
    },
    {
        "name": "Marabou",
        "run": "vehicle compile queries -s windController-record.vcl -f MarabouQueries -o Marabou.queries --network controller:fake.onnx",
        "needs": [
            "windController-record.vcl",
            "fake.onnx"
        ],
        "produces": [
            "Marabou.queries/*.txt",
            "Marabou.queries/safe*.vcl-plan"
        ],
        "ignore": {
            "lines": ".*\"fileHash\".*"
        },
        "sizeOnly": ".vcl-plan"
    },
    {
        "name": "Agda",
        "run": "vehicle compile itp -s windController-record.vcl -t Agda -o Agda.agda",
        "needs": [
            "windController-record.vcl"
        ],
        "produces": [
            "Agda.agda"
        ]
    }
]