@tensor;
record Pair where {a : Real, b : Real} 

@property;
p : (Pair -> Pair) -> Tensor Real;
p = \ f -> const 1.0 nil / search[_t0] [2] (\ dims -> \ xs -> reduceMul xs) (const 0.0 [2]) (const 10.0 [2]) (\ _t0 -> max (const 0.0 nil) (a (f (Pair (_t0 ! 0) (_t0 ! 1))) - _t0 ! 0))

@property;
parallel : (Pair -> Pair) -> Tensor Real;
parallel = \ f -> const 1.0 nil / search[_t0] [2] (\ dims -> \ xs -> reduceMul xs) (const 0.0 [2]) (const 10.0 [2]) (\ _t0 -> max (const 0.0 nil) (a (f (Pair (_t0 ! 0) (_t0 ! 1))) - 0.0)) + search[_t0] [2] (\ dims -> \ xs -> reduceMul xs) (const 0.0 [2]) (const 10.0 [2]) (\ _t0 -> max (const 0.0 nil) (5.0 - b (f (Pair (_t0 ! 0) (_t0 ! 1)))))