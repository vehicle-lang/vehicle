@property;
p1 : (Tensor Real -> Tensor Real) -> Tensor Real;
p1 = \ f -> const 1.0 nil / search[x] nil (\ dims -> \ xs -> reduceMul xs) 0.0 1.0 (\ x -> max (const 0.0 nil) (f x - (0.0 + 1.0)))

@property;
p2 : (Tensor Real -> Tensor Real) -> Tensor Real;
p2 = \ g -> const 1.0 nil / search[x] nil (\ dims -> \ xs -> reduceMul xs) 0.0 1.0 (\ x -> max (const 0.0 nil) (g x - 0.0))