@property;
predicted : (Tensor Real -> Tensor Real) -> Tensor Real;
predicted = \ f -> f [ 0.0, 0.0, 0.0, 0.0 ]

@property;
belowOne : (Tensor Real -> Tensor Real) -> Tensor Real;
belowOne = \ f -> 1.0 / search[x] (\ e -> \ xs -> reduceMul e xs) nil 0.0 1.0 (\ x -> max 0.0 (1.0 - f [x, x, x, x] ! 0))