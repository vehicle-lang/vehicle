[
  {
    "name": "TypeCheck",
    "run": "vehicle typecheck -s spec.vcl",
    "needs": [
      "spec.vcl"
    ]
  },
  {
    "name": "VNNLib",
    "run": "vehicle compile queries -s spec.vcl -f VNNLibQueries -o VNNLib.queries/ --network f:fake.onnx",
    "needs": [
      "spec.vcl",
      "fake.onnx"
    ],
    "produces": [
      "VNNLib.queries/positionsInRange-query1.txt",
      "VNNLib.queries/positionsInRange-query2.txt",
      "VNNLib.queries/positionsInRange-query3.txt",
      "VNNLib.queries/positionsInRange-query4.txt",
      "VNNLib.queries/positionsInRange-query5.txt",
      "VNNLib.queries/positionsInRange-query6.txt",
      "VNNLib.queries/positionUnderLimit-query1.txt",
      "VNNLib.queries/boundedScalar-query1.txt",
      "VNNLib.queries/*.vcl-plan"
    ],
    "ignore": {
      "lines": ".*\"fileHash\".*"
    },
    "sizeOnly": ".vcl-plan"
  },
  {
    "name": "Agda",
    "run": "vehicle compile itp -s spec.vcl -t Agda -o Agda.agda",
    "needs": [
      "spec.vcl"
    ],
    "produces": [
      "Agda.agda"
    ]
  },
  {
    "name": "Rocq",
    "run": "vehicle compile itp -s spec.vcl -t Rocq -o Rocq.v",
    "needs": [
      "spec.vcl"
    ],
    "produces": [
      "Rocq.v"
    ]
  },
  {
    "name": "Isabelle",
    "run": "vehicle compile itp -s spec.vcl -t Isabelle -o isabelle/Isabelle.thy",
    "needs": [
      "spec.vcl"
    ],
    "produces": [
      "isabelle/Isabelle.thy"
    ]
  },
  {
    "name": "Imandra",
    "run": "vehicle compile itp -s spec.vcl -t Imandra -o Imandra.iml",
    "needs": [
      "spec.vcl"
    ],
    "produces": [
      "Imandra.iml"
    ]
  }
]
