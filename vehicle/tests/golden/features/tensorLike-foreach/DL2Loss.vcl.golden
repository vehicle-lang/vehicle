@tensor;
record Pair where {a : Real, b : Real} 

@property;
safeBatch : (Pair -> Pair) -> Tensor Real;
safeBatch = \ f -> [[ 1.0, 1.0 ] / search[_t0] (\ e -> \ xs -> reduceMul e xs) [2] [ 0.0, 0.0 ] [ 1.0, 1.0 ] (\ _t0 -> max 0.0 (a (f (Pair (_t0 ! 0) (_t0 ! 1))))) Pair, [ 1.0, 1.0 ] / search[_t0] (\ e -> \ xs -> reduceMul e xs) [2] [ 0.0, 0.0 ] [ 1.0, 1.0 ] (\ _t0 -> max 0.0 (a (f (Pair (_t0 ! 0) (_t0 ! 1))))) Pair, [ 1.0, 1.0 ] / search[_t0] (\ e -> \ xs -> reduceMul e xs) [2] [ 0.0, 0.0 ] [ 1.0, 1.0 ] (\ _t0 -> max 0.0 (a (f (Pair (_t0 ! 0) (_t0 ! 1))))) Pair]