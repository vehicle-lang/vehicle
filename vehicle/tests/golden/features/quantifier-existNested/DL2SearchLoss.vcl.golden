@network;
f : Tensor Real -> Tensor Real

@property;
existEqualNested : Tensor Real;
existEqualNested = search[x1] (\ dims -> \ xs -> reduceMul xs) nil 0.0 1.0 (\ x1 -> search[x2] (\ dims -> \ xs -> reduceMul xs) nil 1.0 2.0 (\ x2 -> max (const 0.0 nil) (1.0 - f x1) + max (const 0.0 nil) (2.0 - f x2)))

@property;
existLeftMoreNested : Tensor Real;
existLeftMoreNested = search[x1] (\ dims -> \ xs -> reduceMul xs) nil 0.0 1.0 (\ x1 -> search[x2] (\ dims -> \ xs -> reduceMul xs) nil 1.0 2.0 (\ x2 -> search[x3] (\ dims -> \ xs -> reduceMul xs) nil 2.0 3.0 (\ x3 -> max (const 0.0 nil) (1.0 - f x1) + max (const 0.0 nil) (2.0 - f x2) + max (const 0.0 nil) (3.0 - f x3))))

@property;
existRightMoreNested : Tensor Real;
existRightMoreNested = search[x1] (\ dims -> \ xs -> reduceMul xs) nil 0.0 1.0 (\ x1 -> search[x2] (\ dims -> \ xs -> reduceMul xs) nil 1.0 2.0 (\ x2 -> search[x3] (\ dims -> \ xs -> reduceMul xs) nil 2.0 3.0 (\ x3 -> max (const 0.0 nil) (1.0 - f x1) + (max (const 0.0 nil) (2.0 - f x2) + max (const 0.0 nil) (3.0 - f x3)))))